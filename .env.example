# 복사해서 .env 로 사용: cp .env.example .env

# Database (PostgreSQL)
DB_NAME=fixguide
DB_USER=fixguide
DB_PASSWORD=fixguide
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Backend (Spring Boot)
SERVER_PORT=8080

# JWT (secret은 32자 이상, 운영에서는 반드시 변경)
JWT_SECRET=fixguide-dev-jwt-secret-key-change-me-in-production
# Access Token 만료 (초) - 1시간
JWT_EXPIRES_IN=3600

# 프론트 오리진 (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# 기동 시 시드 데이터 주입 여부
SEED_ENABLED=true

# Frontend (Vue + Vite)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

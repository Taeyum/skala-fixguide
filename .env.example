# 복사해서 .env 로 사용: cp .env.example .env

# Database (PostgreSQL)
DB_NAME=fixguide
DB_USER=fixguide
DB_PASSWORD=fixguide
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Backend (Spring Boot)
SERVER_PORT=8080

# JWT (secret은 32자 이상, 운영에서는 반드시 변경 / 만료 시간은 ms 단위)
JWT_SECRET=fixguide-dev-jwt-secret-key-change-me-in-production
# Access Token 30분
JWT_ACCESS_EXPIRATION=1800000
# Refresh Token 14일
JWT_REFRESH_EXPIRATION=1209600000

# Frontend (Vue + Vite)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

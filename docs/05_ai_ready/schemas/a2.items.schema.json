{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixguide.skala/schemas/a2.items.schema.json",
  "title": "A2 적용 법령 결과 (agent_results.payload_json)",
  "description": "루트는 저장·응답 형태. LLM 출력 계약은 $defs.modelOutput. A1 과 구조는 같고 항목 수·본문 규칙이 다르다. 제출 게이트(422 SUBMIT_REQUIRED_FIELD_MISSING)는 items 최소 1건을 요구한다.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["itemId", "text", "edited"],
      "additionalProperties": false,
      "properties": {
        "itemId": { "type": "string", "pattern": "^i-[0-9]{2}$", "description": "서버 채번" },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "법령명 + 조문 번호 + 요구 사항. 조문을 특정할 수 없으면 \"[확인 필요]\" 로 시작하고 조문 번호를 생성하지 않는다."
        },
        "edited": { "type": "boolean", "description": "서버 관리" }
      }
    },
    "modelOutput": {
      "title": "A2 LLM 출력 계약",
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 200 } }
          }
        }
      }
    }
  },
  "examples": [
    {
      "items": [
        { "itemId": "i-01", "text": "산업안전보건기준에 관한 규칙 제38조 — NH3 취급 설비 정비 작업은 작업계획 수립 대상 (작업 전)", "edited": false },
        { "itemId": "i-02", "text": "산업안전보건기준에 관한 규칙 제92조 — 정비 작업 시 운전 정지·잠금장치·표지판 부착 필요 (작업 전)", "edited": false },
        { "itemId": "i-03", "text": "[확인 필요] 고압가스 안전관리법상 2500 psi 운전 압력의 특정고압가스 해당 여부는 사업장 신고 내역 확인 필요", "edited": false }
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixguide.skala/schemas/a1.items.schema.json",
  "title": "A1 규격·호환 결과 (agent_results.payload_json)",
  "description": "루트는 저장·응답 형태(GET /agent-runs/{runId} 이후 조회되는 payload_json). LLM 이 직접 반환해야 하는 형태는 $defs.modelOutput 이며, itemId·edited 는 서버가 채운다.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["itemId", "text", "edited"],
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^i-[0-9]{2}$",
          "description": "서버 채번. PATCH /agent-results/{id} 치환 시 배열에 없는 id 는 삭제된다."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "\"판정: 근거\" 형식의 한 문장. 근거가 없으면 \"[확인 필요]\" 로 시작한다."
        },
        "edited": {
          "type": "boolean",
          "description": "엔지니어 수정 여부. 서버가 관리하며 LLM 은 이 값을 생성하지 않는다."
        }
      }
    },
    "modelOutput": {
      "title": "A1 LLM 출력 계약",
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 120 } }
          }
        }
      }
    }
  },
  "examples": [
    {
      "items": [
        { "itemId": "i-01", "text": "규격 적합: 정격 3000 psi 가 운전 압력 2500 psi 를 상회", "edited": false },
        { "itemId": "i-02", "text": "규격 적합: 운전 온도 80 ℃ 는 밸브 상용 온도 범위 내", "edited": false },
        { "itemId": "i-03", "text": "[확인 필요] 대체 호환품 SS-DLV-4EQ 의 시트 재질은 입력에 없어 판단 불가", "edited": false }
      ]
    }
  ]
}
